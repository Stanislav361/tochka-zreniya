# Telegram-бот, куда приходят уведомления о новых заявках на приём
# (форма записи → /api/booking → Telegram Bot API).
#
# 1. Создайте бота через @BotFather в Telegram, получите токен вида
#    123456789:AAExampleTokenExampleTokenExample
TELEGRAM_BOT_TOKEN=

# 2. ID чата/группы, куда бот будет присылать сообщения.
#    Для личного чата с ботом: напишите ему любое сообщение, затем откройте
#    https://api.telegram.org/bot<TOKEN>/getUpdates и возьмите "chat":{"id": ...}
#    Для группы: добавьте бота в группу, отправьте сообщение в группу и
#    посмотрите тот же getUpdates — id группы обычно отрицательный.
TELEGRAM_CHAT_ID=
